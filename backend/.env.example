PORT=3001

# Database Configuration (MongoDB)
# Example: mongodb://localhost:27017/fooddash or mongodb+srv://<username>:<password>@cluster.mongodb.net/fooddash
MONGO_URI=your_mongodb_connection_string

# Authentication & Security (JWT)
# Secret key used for signing and verifying JSON Web Tokens
JWT_SECRET=your_jwt_secret_key

# In-Memory Cache & Session Store (Redis)
# Used for token blacklisting upon logout and session invalidation
# Example: redis://localhost:6379 or redis://default:<password>@<host>:<port>
REDIS_URL=your_redis_connection_url

# Media Storage (Cloudinary)
# Used by Multer to upload and serve restaurant logos, banners, and menu item images
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
